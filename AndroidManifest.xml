            android:name="com.hex91.file.ApkFileProvider"
            android:authorities="com.hex91.file.files"
            android:exported="false"
            android:grantUriPermissions="true"/>

        <!-- v1.84.0 Storage Access Framework：让系统「文件」应用与其他应用的
             「打开文件 / 选择位置」能直接浏览本机目录。MANAGE_DOCUMENTS 是系统权限，
             只有系统文档 UI 能直接查询；普通应用拿到的是系统授予的临时 URI 权限。 -->
        <provider
            android:name="com.hex91.file.HfDocumentsProvider"
            android:authorities="com.hex91.file.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER"/>
            </intent-filter>
        </provider>

