        <!-- v1.91.0：内置视频播放器（Media3 ExoPlayer 内核）。
             三个入口：
               ① 应用内点视频/长按「播放」；
               ② 顶栏 ⋮ →「播放链接 / 串流…」；
               ③ 外部 Intent（浏览器点 m3u8、其他应用「用 HexFile 打开」）。
             exported=true 是被 ③ 逼出来的，因此入口处做了协议白名单（见 StreamUrl.isSupported）：
             只认 http/https/rtsp/rtmps/file/content，javascript:/intent:/data: 一律拒绝。
             configChanges 必须带上 orientation|screenSize，否则转屏会重建 Activity → 播放中断。
             launchMode=singleTop：连点两个视频不会堆出两层播放器。 -->
        <activity
            android:name="com.hex91.file.VideoPlayerActivity"
            android:label="视频播放"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/VpWindow"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <!-- 本地/其他应用共享的视频：只挂 file/content，不挂 http/https，
                 避免把浏览器里所有视频链接都抢过来 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="file"/>
                <data android:scheme="content"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
            <!-- HLS：各家的 mime 写法五花八门，全列上 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="file"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/vnd.apple.mpegurl"/>
                <data android:mimeType="application/x-mpegurl"/>
                <data android:mimeType="application/x-mpegURL"/>
                <data android:mimeType="audio/mpegurl"/>
                <data android:mimeType="audio/x-mpegurl"/>
            </intent-filter>
            <!-- m3u8 链接拦截：用 pathSuffix 而不是 pathPattern。
                 pathPattern 是「简单 glob」，反斜杠转义在不同版本上语义有差异，
                 写错的表现是「过滤器静默失效」或「连普通网页链接也抢」，两头都很难查。
                 pathSuffix 只做纯文本后缀比较，没有转义问题。
                 host="*" 不能省 —— 只写 scheme+path 时系统会忽略 path 条件，等于接管所有 http 链接。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http" android:host="*" android:pathSuffix=".m3u8"/>
                <data android:scheme="https" android:host="*" android:pathSuffix=".m3u8"/>
                <data android:scheme="http" android:host="*" android:pathSuffix=".mpd"/>
                <data android:scheme="https" android:host="*" android:pathSuffix=".mpd"/>
            </intent-filter>
            <!-- RTSP 摄像头/串流 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="rtsp"/>
            </intent-filter>
        </activity>

        <!-- v1.92.0：HLS 下载 / 合并为 MP4。
             不挂任何 intent-filter：它接受 http 地址与本地路径，exported=false 才不会
