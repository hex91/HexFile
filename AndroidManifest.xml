            android:label="局域网快传"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <!-- 迷你文件共享 Provider：安装 APK 时向系统安装器提供文件 -->
        <!-- v1.85.0 桌面小组件：常用目录 + 存储概览 -->
        <receiver
            android:name="com.hex91.file.WidgetProvider"
            android:exported="false">
            <intent-filter>
