<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hex91.file"
    android:versionCode="109"
    android:versionName="1.64.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="30"/>

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- v1.45.0 应用管理：targetSdk 30 包可见性过滤，需此权限查询全部已安装应用 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <!-- 终端「更新工具」：下载/OTA 检查需要联网 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- v1.50.0 远程管理：传输期间持有高性能 Wi-Fi 锁防休眠断流 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:label="HexFile"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme_Hex_0"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true">

        <activity
            android:name="com.hex91.file.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name="com.hex91.file.SearchActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <activity
            android:name="com.hex91.file.TrashActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <activity
            android:name="com.hex91.file.ZipBrowserActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <activity
            android:name="com.hex91.file.TextEditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name="com.hex91.file.HexViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <activity
            android:name="com.hex91.file.ImageViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <activity
            android:name="com.hex91.file.DexEditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <!-- v1.63.0：smali → Java 源码查看（dex2jar + CFR，全离线插件化） -->
        <activity
            android:name="com.hex91.file.DecompileActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <activity
            android:name="com.hex91.file.ManifestEditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name="com.hex91.file.ArscEditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"/>

        <!-- v1.64.0：ARSC++ 编辑（包→类型→配置 树 + values XML 源码编辑写回） -->
        <activity
            android:name="com.hex91.file.ArscPlusActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name="com.hex91.file.CompareActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <activity
            android:name="com.hex91.file.StringsViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <activity
            android:name="com.hex91.file.BatchRenameActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name="com.hex91.file.AppManagerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <!-- v1.54.0：备份管理（列出所有备份，支持已卸载应用还原） -->
        <activity
            android:name="com.hex91.file.BackupManagerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <!-- v1.48.0：主题设置页（22 套色板 + 跟随系统明暗） -->
        <activity
            android:name="com.hex91.file.ThemeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <!-- v1.49.0：终端模拟器（NDK PTY + 自研 VT100/xterm 仿真）。TEST-EXPORT 仅用于自动化冒烟测试，发布前会改回 false -->
        <activity
            android:name="com.hex91.file.TerminalActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:windowSoftInputMode="adjustResize"/>

        <!-- v1.50.0：远程管理（局域网 HTTP 服务器，服务随页面开启/关闭） -->
        <activity
            android:name="com.hex91.file.RemoteActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>
        <!-- v1.57.0：APK 信息查看（权限/组件/ABI/DEX/签名一览） -->
        <activity
            android:name="com.hex91.file.ApkInfoActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>
        <!-- v1.58.0：PDF 预览（PdfRenderer 渲染/翻页/导出 PNG） -->
        <activity
            android:name="com.hex91.file.PdfPreviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>
        <!-- v1.58.0：字体预览（ttf/otf 样张实时渲染） -->
        <activity
            android:name="com.hex91.file.FontPreviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>
        <!-- v1.59.0：存储分析（目录占用树下钻 + 大文件清理） -->
        <activity
            android:name="com.hex91.file.StorageAnalysisActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>
        <!-- v1.59.0：重复文件查找（三阶段内容级查重） -->
        <activity
            android:name="com.hex91.file.DupFinderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <!-- v1.56.0：网络存储（SMB/WebDAV 客户端，直连电脑共享） -->
        <activity
            android:name="com.hex91.file.NetStorageActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <!-- v1.62.0：Java → Smali 转换（ECJ + dx + baksmali） -->
        <activity
            android:name="com.hex91.file.Java2SmaliActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <!-- v1.61.0：Smali 语法查询（指令中文解析 + 搜索） -->
        <activity
            android:name="com.hex91.file.SmaliDocActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"/>

        <!-- 迷你文件共享 Provider：安装 APK 时向系统安装器提供文件 -->
        <provider
            android:name="com.hex91.file.ApkFileProvider"
            android:authorities="com.hex91.file.files"
            android:exported="false"
            android:grantUriPermissions="true"/>

    </application>
</manifest>
