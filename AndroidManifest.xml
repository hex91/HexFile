    <uses-permission android:name="moe.shizuku.manager.permission.API_V23"/>

    <!-- v1.74.1 明文 HTTP 放行：快传/WebDAV/网络工具的目标地址是运行时才知道的局域网 IP，
         无法枚举成域名白名单，详见 res/xml/network_security_config.xml 的说明。
         usesCleartextTraffic 供 API 23~27 兜底（这批系统还不读 networkSecurityConfig）。 -->
    <application
        android:label="HexFile"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme_Hex_0"
        android:largeHeap="true"
