        <!-- v1.86.0 Shizuku 客户端标记：告诉 Shizuku app 本应用支持 V3 协议。
             缺了它 Shizuku 会按旧协议处理，newProcess 等能力拿不到。 -->
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true"/>

        <!-- v1.86.0 Shizuku 的 binder 不走 Service，而是由客户端自己声明这个
             provider（authorities 必须是「包名 + .shizuku」）由它把 binder 交过来。
             少了它 pingBinder() 恒为 false，而且没有任何报错——最常见的踩坑点。
             permission 是 signature|privileged 级，普通应用无法直接查询。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.hex91.file.shizuku"
            android:enabled="@bool/shizuku_provider_enabled"
