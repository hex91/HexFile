<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/hfBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="?attr/hfTopBar"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <TextView
            android:id="@+id/vt_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/vault_title"
            android:textSize="14sp"
            android:textColor="?attr/hfTopBarText"/>

        <Button
            android:id="@+id/vt_import"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/vault_import"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/vt_more"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/vault_more"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/vt_close"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/vault_close"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/vt_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:textSize="11sp"
        android:textColor="?attr/hfTextSub"/>

    <!-- 锁定 / 首次设置：两种状态共用这一块，只换标题、第二个口令框与按钮文案 -->
    <LinearLayout
        android:id="@+id/vt_lock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/vt_lock_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vault_unlock_title"
            android:textSize="16sp"
            android:textColor="?attr/hfText"/>

        <EditText
            android:id="@+id/vt_pw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/vault_pw_hint"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="?attr/hfText"
            android:textColorHint="?attr/hfTextSub"/>

        <EditText
            android:id="@+id/vt_pw2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/vault_pw2_hint"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="?attr/hfText"
            android:textColorHint="?attr/hfTextSub"
            android:visibility="gone"/>

        <Button
            android:id="@+id/vt_go"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:text="@string/vault_btn_unlock"
            android:textSize="13sp"/>

        <!-- F-25：只有「设备支持 + 已开启」时才显示；其余情况一律走口令 -->
        <Button
            android:id="@+id/vt_bio"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:text="@string/vault_bio"
            android:textSize="13sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/vt_err"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:visibility="gone"/>
    </LinearLayout>

    <TextView
        android:id="@+id/vt_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:textSize="13sp"
        android:textColor="?attr/hfTextSub"
        android:text="@string/vault_empty"
        android:visibility="gone"/>

    <ListView
        android:id="@+id/vt_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="?attr/hfDivider"
        android:dividerHeight="1dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/vt_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textSize="11sp"
        android:textColor="?attr/hfTextSub"
        android:text="@string/vault_lock_hint"/>
</LinearLayout>
