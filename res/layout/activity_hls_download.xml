<?xml version="1.0" encoding="utf-8"?>
<!-- v1.92.0 HLS 下载 / 合并为 MP4。
     页面只做一件事：把一条 m3u8 变成手机里能播的单个文件。
     表单式布局与云同步页一致（顶栏 + 滚动表单 + 底部主按钮），
     避免再引入一套视觉语言。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/hfBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="?attr/hfTopBar"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="10dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="‹"
            android:textColor="?attr/hfTopBarText"
            android:textSize="26sp"
            android:background="?android:attr/selectableItemBackground"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="2dp"
            android:text="下载视频 / 合并为 MP4"
            android:textColor="?attr/hfTopBarText"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btn_help"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="48dp"
            android:text="?"
            android:textColor="?attr/hfTopBarText"
            android:textSize="17sp"
            android:background="?android:attr/selectableItemBackground"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="粘贴 m3u8 地址（或本地 .m3u8 文件路径）。支持 AES-128 加密、按字节区间切片、fMP4 分片。"
                android:textColor="?attr/hfTextSub"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"/>

            <EditText
                android:id="@+id/et_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minLines="2"
                android:gravity="top|start"
                android:hint="https://example.com/xxx/index.m3u8"
                android:textSize="13sp"
                android:textColor="?attr/hfText"
                android:textColorHint="?attr/hfTextSub"
                android:inputType="textUri|textMultiLine"
                android:background="?attr/hfSurfaceAlt"
                android:padding="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_paste"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="粘贴剪贴板"/>

                <Button
                    android:id="@+id/btn_parse"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:text="解析"/>
            </LinearLayout>

            <!-- ==== 解析结果 ==== -->
            <TextView
                android:id="@+id/tv_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="10dp"
                android:visibility="gone"
                android:textColor="?attr/hfText"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:background="?attr/hfSurface"/>

            <!-- 画质（只有 master 多档才显示） -->
            <TextView
                android:id="@+id/row_quality"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:textColor="?attr/hfText"
                android:textSize="14sp"
                android:background="?android:attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/row_dir"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:textColor="?attr/hfText"
                android:textSize="14sp"
                android:background="?android:attr/selectableItemBackground"/>

            <CheckBox
                android:id="@+id/cb_mp4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="下载后转为 MP4（只换容器，不重新编码）"
                android:textColor="?attr/hfText"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="开始下载"/>

            <ProgressBar
                android:id="@+id/pb"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/hfTextSub"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:text="取消"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:textColor="?attr/hfTextSub"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:visibility="gone"
                android:background="?attr/hfSurfaceAlt"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
