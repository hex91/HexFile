<?xml version="1.0" encoding="utf-8"?>
<!-- v1.80.0 网格视图单元格：正方形图标区 + 单行文件名（名称在图标下方而不是压在图上，
     这样目录、文档这类没有缩略图的条目也读得清） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="3dp"
    android:paddingRight="3dp"
    android:paddingTop="6dp"
    android:paddingBottom="2dp">

    <FrameLayout
        android:id="@+id/grid_frame"
        android:layout_width="match_parent"
        android:layout_height="92dp">

        <ImageView
            android:id="@+id/grid_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/grid_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/grid_check"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="✓"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"/>
    </FrameLayout>

    <TextView
        android:id="@+id/grid_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="middle"
        android:textSize="11sp"
        android:textColor="?attr/hfText"/>
</LinearLayout>
