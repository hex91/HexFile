<?xml version="1.0" encoding="utf-8"?>
<!-- v1.70.0 加解密：Base64/哈希/国密/AES/DES 一套界面，按算法动态显隐密钥与 IV -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/hfBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="8dp"
        android:background="?attr/hfSurfaceAlt">

        <TextView
            android:id="@+id/cp_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textSize="24sp"
            android:textColor="?attr/hfText"
            android:background="?android:attr/selectableItemBackground"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="加解密"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/hfText"/>

            <TextView
                android:id="@+id/cp_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Base64 · 哈希 · AES/DES · 国密 SM3/SM4"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="?attr/hfTextSub"/>
        </LinearLayout>

        <TextView
            android:id="@+id/cp_copy"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="10dp"
            android:text="复制"
            android:textSize="13sp"
            android:textColor="?attr/hfTextSub"
            android:background="?android:attr/selectableItemBackground"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <Spinner
                android:id="@+id/cp_alg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:spinnerMode="dialog"
                android:background="?attr/hfSurfaceAlt"/>

            <!-- 密钥 -->
            <LinearLayout
                android:id="@+id/cp_key_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="密钥"
                    android:textSize="11sp"
                    android:textColor="?attr/hfTextSub"/>

                <EditText
                    android:id="@+id/cp_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:textSize="13sp"
                    android:hint="例如 0123456789abcdef"
                    android:textColorHint="?attr/hfTextSub"
                    android:textColor="?attr/hfText"
                    android:background="?attr/hfSurfaceAlt"/>

                <TextView
                    android:id="@+id/cp_key_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="10.5sp"
                    android:textColor="?attr/hfTextSub"/>
            </LinearLayout>

            <!-- IV + 模式 -->
            <LinearLayout
                android:id="@+id/cp_iv_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="IV（CBC 用，空则全 0）"
                        android:textSize="11sp"
                        android:textColor="?attr/hfTextSub"/>

                    <TextView
                        android:id="@+id/cp_mode_ecb"
                        style="@style/HexChip"
                        android:layout_height="28dp"
                        android:text="ECB"/>

                    <TextView
                        android:id="@+id/cp_mode_cbc"
                        style="@style/HexChip"
                        android:layout_height="28dp"
                        android:text="CBC"/>
                </LinearLayout>

                <EditText
                    android:id="@+id/cp_iv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:textSize="13sp"
                    android:hint="16 字节"
                    android:textColorHint="?attr/hfTextSub"
                    android:textColor="?attr/hfText"
                    android:background="?attr/hfSurfaceAlt"/>
            </LinearLayout>

            <!-- 输出格式 -->
            <LinearLayout
                android:id="@+id/cp_out_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="密文输出格式"
                    android:textSize="11sp"
                    android:textColor="?attr/hfTextSub"/>

                <TextView
                    android:id="@+id/cp_fmt_b64"
                    style="@style/HexChip"
                    android:layout_height="28dp"
                    android:text="Base64"/>

                <TextView
                    android:id="@+id/cp_fmt_hex"
                    style="@style/HexChip"
                    android:layout_height="28dp"
                    android:text="HEX"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="输入"
                android:textSize="11sp"
                android:textColor="?attr/hfTextSub"/>

            <EditText
                android:id="@+id/cp_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="88dp"
                android:gravity="top|start"
                android:padding="10dp"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:inputType="textMultiLine|textNoSuggestions"
                android:hint="要加密的明文，或要解密的密文（自动识别 Base64 / HEX）"
                android:textColorHint="?attr/hfTextSub"
                android:textColor="?attr/hfText"
                android:background="?attr/hfSurfaceAlt"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/cp_go1"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="加密"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/hfOnAccent"/>

                <TextView
                    android:id="@+id/cp_go2"
                    style="@style/HexChip"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:text="解密"/>
            </LinearLayout>

            <TextView
                android:id="@+id/cp_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/hfTextSub"/>

            <TextView
                android:id="@+id/cp_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="72dp"
                android:padding="10dp"
                android:typeface="monospace"
                android:textSize="12.5sp"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true"
                android:textColor="?attr/hfText"
                android:background="?attr/hfSurfaceAlt"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
