<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/hfBg">

    <TextView
        android:id="@+id/zip_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/hfText"
        android:background="?attr/hfSurfaceAlt"
        android:minHeight="44dp"/>

    <!-- v2.16.0（F-21）：四个按钮等分。「搜索」紧跟「上级」，包内找文件是高频动作；
         破坏性的「关闭」仍在最右。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/zip_up"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="@string/zip_up"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/zip_search"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="@string/zip_search"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/zip_extract"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="@string/zip_extract_all"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/zip_close"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="@string/zip_close"
            android:textSize="12sp"/>
    </LinearLayout>

    <ListView
        android:id="@+id/zip_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
