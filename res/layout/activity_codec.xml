<?xml version="1.0" encoding="utf-8"?>
<!-- v1.70.0 编码转换：源格式 / 目标格式 任选，输入即时出结果 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/hfBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="8dp"
        android:background="?attr/hfSurfaceAlt">

        <TextView
            android:id="@+id/cd_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textSize="24sp"
            android:textColor="?attr/hfText"
            android:background="?android:attr/selectableItemBackground"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="编码转换"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/hfText"/>

            <TextView
                android:id="@+id/cd_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="任意两种格式互转"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="?attr/hfTextSub"/>
        </LinearLayout>

        <TextView
            android:id="@+id/cd_swap"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="10dp"
            android:text="⇄ 互换"
            android:textSize="13sp"
            android:textColor="?attr/hfAccent"
            android:background="?android:attr/selectableItemBackground"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/hfSurfaceAlt"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <Spinner
                    android:id="@+id/cd_from"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="16sp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:textColor="?attr/hfAccent"/>

                <Spinner
                    android:id="@+id/cd_to"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="输入"
                android:textSize="11sp"
                android:textColor="?attr/hfTextSub"/>

            <EditText
                android:id="@+id/cd_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:gravity="top|start"
                android:padding="10dp"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:inputType="textMultiLine|textNoSuggestions"
                android:hint="在这里输入或粘贴内容…"
                android:textColorHint="?attr/hfTextSub"
                android:textColor="?attr/hfText"
                android:background="?attr/hfSurfaceAlt"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/cd_paste"
                    style="@style/HexChip"
                    android:text="粘贴"/>

                <TextView
                    android:id="@+id/cd_clear"
                    style="@style/HexChip"
                    android:text="清空"/>

                <TextView
                    android:id="@+id/cd_use"
                    style="@style/HexChip"
                    android:text="结果→输入"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/cd_copy"
                    style="@style/HexChip"
                    android:textColor="?attr/hfAccent"
                    android:text="复制"/>
            </LinearLayout>

            <TextView
                android:id="@+id/cd_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/hfTextSub"
                android:text=""/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="结果"
                android:textSize="11sp"
                android:textColor="?attr/hfTextSub"/>

            <TextView
                android:id="@+id/cd_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:padding="10dp"
                android:typeface="monospace"
                android:textSize="12.5sp"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true"
                android:textColor="?attr/hfText"
                android:background="?attr/hfSurfaceAlt"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
