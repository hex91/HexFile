<?xml version="1.0" encoding="utf-8"?>
<!-- v1.68.1：字体可调（Aa）+ 逐字节十六进制键盘 + 列头/正文横向同步滚动 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/hfBg">

    <!-- 顶栏：返回 / 文件名+大小 / 文件解析 / 键盘 / 保存（未修改时禁用） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="8dp"
        android:background="?attr/hfSurfaceAlt">

        <TextView
            android:id="@+id/hex_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textSize="24sp"
            android:textColor="?attr/hfText"
            android:background="?android:attr/selectableItemBackground"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hex_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/hfText"/>

            <TextView
                android:id="@+id/hex_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="?attr/hfTextSub"/>
        </LinearLayout>

        <TextView
            android:id="@+id/hex_info"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="ⓘ"
            android:textSize="18sp"
            android:textColor="?attr/hfTextSub"
            android:background="?android:attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/hex_keyboard"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⌨"
            android:textSize="20sp"
            android:textColor="?attr/hfAccent"
            android:background="?android:attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/hex_save"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="💾"
            android:textSize="18sp"
            android:textColor="?attr/hfText"
            android:alpha="0.3"
            android:background="?android:attr/selectableItemBackground"/>
    </LinearLayout>

    <!-- 工具条（可横向滚动，小屏也能塞下） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:scrollbars="none"
        android:background="?attr/hfSurface">

        <LinearLayout
            android:id="@+id/hex_tools"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/hex_jump"
                style="@style/HexChip"
                android:text="跳转"/>

            <TextView
                android:id="@+id/hex_block"
                style="@style/HexChip"
                android:text="块"/>

            <TextView
                android:id="@+id/hex_search"
                style="@style/HexChip"
                android:text="搜索"/>

            <TextView
                android:id="@+id/hex_copy"
                style="@style/HexChip"
                android:text="复制"/>

            <TextView
                android:id="@+id/hex_undo"
                style="@style/HexChip"
                android:text="↶ 撤销"/>

            <TextView
                android:id="@+id/hex_redo"
                style="@style/HexChip"
                android:text="↷ 重做"/>

            <TextView
                android:id="@+id/hex_base"
                style="@style/HexChip"
                android:text="HEX"/>

            <TextView
                android:id="@+id/hex_charset"
                style="@style/HexChip"
                android:text="LATIN1"/>

            <TextView
                android:id="@+id/hex_font"
                style="@style/HexChip"
                android:text="Aa"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 列头：与行文本同字体同尺寸同宽度，横向滚动与正文双向同步 -->
    <HorizontalScrollView
        android:id="@+id/hex_header_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="?attr/hfSurfaceAlt">

        <TextView
            android:id="@+id/hex_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:typeface="monospace"
            android:textSize="11sp"
            android:maxLines="1"
            android:textColor="?attr/hfTextSub"/>
    </HorizontalScrollView>

    <!-- 正文：字体放大后整行超屏，用横向滚动查看（列头跟随） -->
    <HorizontalScrollView
        android:id="@+id/hex_list_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <ListView
            android:id="@+id/hex_list"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:divider="@null"
            android:fastScrollEnabled="false"/>
    </HorizontalScrollView>

    <!-- 底部十六进制键盘（点 ⌨ 或点行内字节弹出；只有 0-9 A-F + 退格 + 收起） -->
    <LinearLayout
        android:id="@+id/hex_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="?attr/hfSurfaceAlt">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/hex_panel_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="76dp"
                android:typeface="monospace"
                android:textSize="12sp"
                android:textColor="?attr/hfAccent"
                android:text="00000000"/>

            <TextView
                android:id="@+id/hex_panel_cur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:typeface="monospace"
                android:textSize="13sp"
                android:textColor="?attr/hfText"
                android:text="--"/>

            <TextView
                android:id="@+id/hex_panel_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="◀"
                android:textSize="15sp"
                android:textColor="?attr/hfText"
                android:background="?android:attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/hex_panel_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="▶"
                android:textSize="15sp"
                android:textColor="?attr/hfText"
                android:background="?android:attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/hex_panel_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="✕"
                android:textSize="15sp"
                android:textColor="?attr/hfTextSub"
                android:background="?android:attr/selectableItemBackground"/>
        </LinearLayout>

        <TextView
            android:id="@+id/hex_panel_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="11sp"
            android:textColor="?attr/hfTextSub"
            android:text="点行内任一字节即可选中，按 2 位十六进制直接写入"/>

        <!-- 键盘按键在代码里生成（3 行 × 6 键） -->
        <LinearLayout
            android:id="@+id/hex_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"/>
    </LinearLayout>

</LinearLayout>
