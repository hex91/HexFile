<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/hfBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="?attr/hfTopBar"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <TextView
            android:id="@+id/sc_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/sched_title"
            android:textSize="14sp"
            android:textColor="?attr/hfTopBarText"/>

        <Button
            android:id="@+id/sc_new"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/sched_new"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/sc_close"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/sched_close"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/sc_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textSize="12sp"
        android:textColor="?attr/hfTextSub"
        android:text="@string/sched_hint"/>

    <TextView
        android:id="@+id/sc_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:textSize="13sp"
        android:textColor="?attr/hfTextSub"
        android:text="@string/sched_empty"/>

    <ListView
        android:id="@+id/sc_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="?attr/hfDivider"
        android:dividerHeight="1dp"/>
</LinearLayout>
