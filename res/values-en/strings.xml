    <string name="settings_shizuku">Use Shizuku (no Root)</string>
    <string name="settings_shizuku_sub">With Shizuku installed and authorized, commands run as shell. Note: this is not root, so other apps\' private folders under /data/data (700) stay unreadable.</string>
