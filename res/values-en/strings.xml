    <string name="settings_widget_add">Add to Home Screen</string>
    <string name="settings_widget_add_sub">Long-press an empty spot on the home screen → Widgets → HexFile, then drag the card out. It carries four shortcuts: working folder, downloads, images and recycle bin.</string>
