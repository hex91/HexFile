<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MT 风格主题：深色顶栏 + 白色列表 + 蓝色强调 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#263238</item>
        <item name="android:colorAccent">#1E88E5</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="android:statusBarColor">#1B1B1B</item>
        <item name="android:navigationBarColor">#263238</item>
    </style>

    <!-- APK 信息弹窗底部操作按钮（蓝字文本，对标 MT） -->
    <style name="ApkActionText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">10dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/hfAccent</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <!-- 编辑器底部快捷符号按钮（小方块，横向滚动） -->
    <style name="SymBtn">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/hfText</item>
        <item name="android:background">?attr/hfSurfaceAlt</item>
    </style>

    <!-- v1.68.0：Hex 编辑器工具条的胶囊按钮 -->
    <style name="HexChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginLeft">3dp</item>
        <item name="android:layout_marginRight">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/hfText</item>
        <item name="android:background">?attr/hfSurfaceAlt</item>
    </style>

    <!-- v1.91.0：播放器底栏胶囊按钮（黑底白字，固定配色，不随主题变化） -->
    <!-- v1.95.2：胶囊从「纯文字」改成「图标 + 极短状态词」。
         图标 16dp 由 vector 的 intrinsic 尺寸决定，drawablePadding 4dp，
         左右 padding 收到 9dp —— 六个胶囊在 320dp 窄屏上还能一屏放下。 -->
    <style name="VpChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginRight">6dp</item>
        <item name="android:paddingLeft">9dp</item>
        <item name="android:paddingRight">9dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/vp_chip</item>
    </style>

    <!-- 纯图标胶囊（信息 / 右下角全屏-竖屏）：没有文字，靠 40dp 宽度撑出手指可点面积 -->
    <style name="VpChipIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginRight">6dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/vp_chip</item>
    </style>
    <!-- v1.91.0：播放器的「启动窗口」主题。
         只影响 setContentView 之前那一瞬（BaseActivity 会再套应用主题），
         但白色闪一下在纯黑播放器上非常刺眼，所以单独给个黑底。 -->
    <style name="VpWindow" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
    </style>
</resources>
